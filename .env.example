# Copia de plantilla: duplicar como .env.local y llenar valores reales.

# Supabase — obtener en Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión de operador — secreto para firmar cookie HMAC (generar: openssl rand -base64 32)
SECRETO_SESION_OPERADOR=

# Brevo (Correo)
BREVO_API_KEY=

# Sentry (Errores)
SENTRY_AUTH_TOKEN=
