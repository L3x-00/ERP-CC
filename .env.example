# Copia de plantilla: duplicar como .env.local y llenar valores reales.
# Regla permanente: ningún archivo .env real se sube a GitHub (ver .gitignore).
# Los valores productivos viven únicamente en Vercel/Supabase.

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión de operador — secreto para firmar cookie HMAC (generar: openssl rand -base64 32)
SECRETO_SESION_OPERADOR=

# URL pública del ERP para enlaces en correos; en Vercel se usa VERCEL_URL si falta.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# OpenRouter (OCR de comprobantes con modelos gratuitos multimodales)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Brevo (correo transaccional) — el remitente debe estar verificado en Brevo.
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=ORCA MFG ERP
BREVO_WEBHOOK_TOKEN=
